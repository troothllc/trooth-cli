{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trooth.co/schemas/public-record.v1.schema.json",
  "title": "PublicRecordReading",
  "description": "What a company has published outside its own website, read from the authorities that hold it (SEC EDGAR, the GLEIF LEI registry, DNS, a Certificate Transparency monitor, the OFAC list, and since trooth 0.12.0 SAM.gov, the USPTO, four state registries, the FTC and RDAP), beside what its own site states, and the evidence tying each identifier to the domain. Served at https://api.trooth.co/scan/public-record/<domain>. Every fact carries the URL to read it again. Since trooth 0.11.0 each reading also carries `signed`: a statement naming the SHA-256 of the reading's RFC 8785 bytes (everything except `signed`), signed with Trooth's statement key and logged. Nothing in it grades, rates or ranks a company. docs/EVIDENCE.md in trooth-cli is the normative text.",
  "type": "object",
  "required": [
    "format",
    "domain",
    "subject_id",
    "read_at",
    "site",
    "bindings",
    "sec",
    "lei",
    "dns",
    "not_read",
    "note"
  ],
  "properties": {
    "format": {
      "type": "string",
      "description": "The format.",
      "const": "trooth.public-record.v1"
    },
    "domain": {
      "type": "string",
      "description": "The domain read."
    },
    "subject_id": {
      "type": "string",
      "description": "trooth:domain:<domain>.",
      "pattern": "^trooth:domain:[a-z0-9.-]+$"
    },
    "read_at": {
      "type": "string",
      "description": "When Trooth read the sources. An ISO 8601 date-time in UTC, as written by Trooth (for example 2026-10-06T20:00:44.820Z)."
    },
    "site": {
      "$ref": "#/$defs/SiteRead",
      "description": "What the company's own pages say about which legal entity it is."
    },
    "bindings": {
      "type": "array",
      "description": "Each identifier found and the evidence for and against tying it to the domain.",
      "items": {
        "$ref": "#/$defs/EntityBinding"
      }
    },
    "sec": {
      "oneOf": [
        {
          "$ref": "#/$defs/SecRecord"
        },
        {
          "type": "null"
        }
      ],
      "description": "The SEC filer's record, or null when no filer was identified."
    },
    "lei": {
      "oneOf": [
        {
          "$ref": "#/$defs/LeiRecord"
        },
        {
          "type": "null"
        }
      ],
      "description": "The LEI record, or null when none was identified."
    },
    "dns": {
      "type": "array",
      "description": "Mail-authentication records beyond SPF and DMARC, and DNSSEC.",
      "items": {
        "$ref": "#/$defs/PublicFact"
      }
    },
    "entity": {
      "oneOf": [
        {
          "$ref": "#/$defs/Entity"
        },
        {
          "type": "null"
        }
      ],
      "description": "The legal entity the domain is tied to, when a binding is corroborated; null otherwise. Added in trooth 0.11.0."
    },
    "certificates": {
      "oneOf": [
        {
          "$ref": "#/$defs/Certificates"
        },
        {
          "type": "null"
        }
      ],
      "description": "Unexpired certificates for the exact domain name in Certificate Transparency logs, as a CT monitor returned them; null when it did not answer. Added in trooth 0.11.0."
    },
    "security_txt": {
      "oneOf": [
        {
          "$ref": "#/$defs/SecurityTxt"
        },
        {
          "type": "null"
        }
      ],
      "description": "The site's /.well-known/security.txt (RFC 9116), or null when there is none or the site opted out of being read. Added in trooth 0.11.0."
    },
    "sanctions": {
      "oneOf": [
        {
          "$ref": "#/$defs/Sanctions"
        },
        {
          "type": "null"
        }
      ],
      "description": "Entries on the OFAC sanctions list with exactly the legal names above. A name match is not an identification. Null when the list could not be read or no name was found. Added in trooth 0.11.0."
    },
    "sources": {
      "type": "array",
      "description": "Every response read for this reading, with the SHA-256 of the bytes read; Trooth keeps the bytes under that hash so a disputed fact can be replayed. Added in trooth 0.11.0.",
      "items": {
        "$ref": "#/$defs/Source"
      }
    },
    "not_read": {
      "type": "array",
      "description": "Each source that was not read, or did not answer, and why. A source not read is never guessed at.",
      "items": {
        "$ref": "#/$defs/NotRead"
      }
    },
    "note": {
      "type": "string",
      "description": "What the reading is and is not, as a paragraph."
    },
    "sam": {
      "oneOf": [
        {
          "$ref": "#/$defs/Sam"
        },
        {
          "type": "null"
        }
      ],
      "description": "SAM.gov registrations and exclusions under the legal name, or null when SAM.gov was not read (not_read says why). A name match is not an identification. Added in trooth 0.12.0."
    },
    "patents": {
      "oneOf": [
        {
          "$ref": "#/$defs/Patents"
        },
        {
          "type": "null"
        }
      ],
      "description": "Patent applications whose first applicant is the legal name, from the USPTO Open Data Portal, or null when it was not read. Added in trooth 0.12.0."
    },
    "registries": {
      "type": "array",
      "description": "Exact-name entries in the state business registries that publish open data (New York, Colorado, Connecticut, Oregon). A name match is not an identification. Added in trooth 0.12.0.",
      "items": {
        "$ref": "#/$defs/RegistryEntry"
      }
    },
    "merger_review": {
      "oneOf": [
        {
          "$ref": "#/$defs/MergerReview"
        },
        {
          "type": "null"
        }
      ],
      "description": "Hart-Scott-Rodino early termination notices the FTC published naming the legal name as a party, or null when they were not read. Added in trooth 0.12.0."
    },
    "domain_registration": {
      "oneOf": [
        {
          "$ref": "#/$defs/DomainRegistration"
        },
        {
          "type": "null"
        }
      ],
      "description": "The domain's registration, from RDAP, or null when no RDAP service answered. Added in trooth 0.12.0."
    },
    "changes": {
      "type": "array",
      "description": "What the sources in this reading record as having changed (renames, acquisitions and dispositions, changes in control, previous legal names, parents, merger review, domain registration), newest first. Added in trooth 0.12.0.",
      "items": {
        "$ref": "#/$defs/Change"
      }
    },
    "subjects": {
      "type": "array",
      "description": "Every subject this reading names, each with why: the domain, the entity, filer and LEI ids, jurisdictions, state registry entries, SAM.gov UEIs, and the code repositories, APIs and MCP servers the home page links to (docs/IDS.md). Added in trooth 0.12.0.",
      "items": {
        "$ref": "#/$defs/Subject"
      }
    },
    "signed": {
      "$ref": "#/$defs/Signed",
      "description": "The statement that names this reading, and its log receipt. Not part of the bytes it names. Added in trooth 0.11.0."
    }
  },
  "$defs": {
    "Sam": {
      "title": "SamReading",
      "type": "object",
      "description": "SAM.gov, read under one legal name with Trooth's key (the key is never in the record). Cached for 30 days per name, so read_at can be earlier than the reading's.",
      "required": [
        "source",
        "read_at",
        "names_checked",
        "registrations",
        "exclusions"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "The SAM.gov API read."
        },
        "read_at": {
          "type": "string",
          "description": "When SAM.gov was read. An ISO 8601 date-time in UTC, as written by Trooth (for example 2026-10-06T20:00:44.820Z)."
        },
        "names_checked": {
          "type": "array",
          "description": "The legal names searched.",
          "items": {
            "type": "string",
            "description": "A name."
          }
        },
        "registrations": {
          "type": "array",
          "description": "Entity registrations with exactly that legal name, at most 10.",
          "items": {
            "$ref": "#/$defs/SamRegistration"
          }
        },
        "exclusions": {
          "type": "array",
          "description": "Exclusion records with exactly that name, at most 20. A name match is not an identification.",
          "items": {
            "$ref": "#/$defs/SamExclusion"
          }
        }
      }
    },
    "SamRegistration": {
      "title": "SamRegistration",
      "type": "object",
      "description": "A SAM.gov entity registration.",
      "required": [
        "uei",
        "cage",
        "legal_name",
        "status",
        "expires",
        "purpose"
      ],
      "properties": {
        "uei": {
          "type": [
            "string",
            "null"
          ],
          "description": "The Unique Entity ID."
        },
        "cage": {
          "type": [
            "string",
            "null"
          ],
          "description": "The CAGE code."
        },
        "legal_name": {
          "type": "string",
          "description": "The legal business name registered."
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "description": "The registration status."
        },
        "expires": {
          "type": [
            "string",
            "null"
          ],
          "description": "The registration expiration date."
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ],
          "description": "The purpose of registration."
        }
      }
    },
    "SamExclusion": {
      "title": "SamExclusion",
      "type": "object",
      "description": "A SAM.gov exclusion record.",
      "required": [
        "name",
        "uei",
        "cage",
        "classification",
        "type",
        "program",
        "agency",
        "active",
        "terminates",
        "record_status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The name excluded."
        },
        "uei": {
          "type": [
            "string",
            "null"
          ],
          "description": "The UEI on the record."
        },
        "cage": {
          "type": [
            "string",
            "null"
          ],
          "description": "The CAGE code on the record."
        },
        "classification": {
          "type": [
            "string",
            "null"
          ],
          "description": "Firm, Individual, Vessel or Special Entity Designation."
        },
        "type": {
          "type": [
            "string",
            "null"
          ],
          "description": "The exclusion type."
        },
        "program": {
          "type": [
            "string",
            "null"
          ],
          "description": "The exclusion program."
        },
        "agency": {
          "type": [
            "string",
            "null"
          ],
          "description": "The excluding agency."
        },
        "active": {
          "type": [
            "string",
            "null"
          ],
          "description": "The activation date."
        },
        "terminates": {
          "type": [
            "string",
            "null"
          ],
          "description": "The termination date, or Indefinite."
        },
        "record_status": {
          "type": [
            "string",
            "null"
          ],
          "description": "The record status."
        }
      }
    },
    "Patents": {
      "title": "PatentReading",
      "type": "object",
      "description": "Patent applications from the USPTO Open Data Portal. Cached for 7 days per name.",
      "required": [
        "source",
        "read_at",
        "applicant_names",
        "applications",
        "recent"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "The search API read."
        },
        "read_at": {
          "type": "string",
          "description": "When it was read. An ISO 8601 date-time in UTC, as written by Trooth (for example 2026-10-06T20:00:44.820Z)."
        },
        "applicant_names": {
          "type": "array",
          "description": "The first-applicant names searched.",
          "items": {
            "type": "string",
            "description": "A name."
          }
        },
        "applications": {
          "type": "integer",
          "description": "How many applications the search counted.",
          "minimum": 0
        },
        "recent": {
          "type": "array",
          "description": "The newest applications, at most 5.",
          "items": {
            "$ref": "#/$defs/PatentApplication"
          }
        }
      }
    },
    "PatentApplication": {
      "title": "PatentApplication",
      "type": "object",
      "description": "A patent application.",
      "required": [
        "application",
        "title",
        "filed",
        "status",
        "patent",
        "granted"
      ],
      "properties": {
        "application": {
          "type": "string",
          "description": "The application number."
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "The title of the invention."
        },
        "filed": {
          "type": [
            "string",
            "null"
          ],
          "description": "The filing date."
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "description": "The application status."
        },
        "patent": {
          "type": [
            "string",
            "null"
          ],
          "description": "The patent number, once granted."
        },
        "granted": {
          "type": [
            "string",
            "null"
          ],
          "description": "The grant date."
        }
      }
    },
    "RegistryEntry": {
      "title": "RegistryEntry",
      "type": "object",
      "description": "An entry in a state business registry with exactly the legal name.",
      "required": [
        "jurisdiction",
        "registry",
        "id",
        "name",
        "status",
        "entity_type",
        "formed",
        "formation_jurisdiction",
        "source"
      ],
      "properties": {
        "jurisdiction": {
          "type": "string",
          "description": "The registry's jurisdiction, ISO 3166-2.",
          "pattern": "^US-[A-Z]{2}$"
        },
        "registry": {
          "type": "string",
          "description": "The registry and dataset."
        },
        "id": {
          "type": "string",
          "description": "The entity's number in that registry."
        },
        "name": {
          "type": "string",
          "description": "The name as registered."
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "description": "The status the registry gives (Active for the datasets of active entities only)."
        },
        "entity_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "The entity type."
        },
        "formed": {
          "type": [
            "string",
            "null"
          ],
          "description": "The formation or registration date in that state."
        },
        "formation_jurisdiction": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where the entity was formed, as the registry writes it."
        },
        "source": {
          "type": "string",
          "description": "The open-data URL for this entry."
        }
      }
    },
    "MergerReview": {
      "title": "MergerReview",
      "type": "object",
      "description": "FTC early termination notices under the HSR Act, searched by words of the legal name and kept when a party has exactly that name. Cached for 7 days per name.",
      "required": [
        "source",
        "read_at",
        "names_checked",
        "notices",
        "matched_in_search"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "The FTC API read."
        },
        "read_at": {
          "type": "string",
          "description": "When it was read. An ISO 8601 date-time in UTC, as written by Trooth (for example 2026-10-06T20:00:44.820Z)."
        },
        "names_checked": {
          "type": "array",
          "description": "The legal names searched.",
          "items": {
            "type": "string",
            "description": "A name."
          }
        },
        "notices": {
          "type": "array",
          "description": "Notices naming the company as a party, at most 20.",
          "items": {
            "$ref": "#/$defs/MergerNotice"
          }
        },
        "matched_in_search": {
          "type": "integer",
          "description": "How many notices the word search returned before names were compared.",
          "minimum": 0
        }
      }
    },
    "MergerNotice": {
      "title": "MergerNotice",
      "type": "object",
      "description": "An early termination notice.",
      "required": [
        "transaction",
        "date",
        "acquiring",
        "acquired",
        "acquired_entities",
        "role",
        "url"
      ],
      "properties": {
        "transaction": {
          "type": "string",
          "description": "The HSR transaction number."
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "description": "The date early termination was granted."
        },
        "acquiring": {
          "type": [
            "string",
            "null"
          ],
          "description": "The acquiring person."
        },
        "acquired": {
          "type": [
            "string",
            "null"
          ],
          "description": "The acquired person."
        },
        "acquired_entities": {
          "type": "array",
          "description": "The acquired entities named.",
          "items": {
            "type": "string",
            "description": "An entity."
          }
        },
        "role": {
          "type": "string",
          "description": "The company's role in the notice.",
          "enum": [
            "acquiring",
            "acquired"
          ]
        },
        "url": {
          "type": "string",
          "description": "The notice on ftc.gov."
        }
      }
    },
    "DomainRegistration": {
      "title": "DomainRegistration",
      "type": "object",
      "description": "A domain's registration from RDAP (RFC 9083).",
      "required": [
        "source",
        "registrar",
        "registered",
        "changed",
        "expires",
        "transferred",
        "status"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "The RDAP URL read."
        },
        "registrar": {
          "type": [
            "string",
            "null"
          ],
          "description": "The registrar."
        },
        "registered": {
          "type": [
            "string",
            "null"
          ],
          "description": "The registration date."
        },
        "changed": {
          "type": [
            "string",
            "null"
          ],
          "description": "The last-changed date."
        },
        "expires": {
          "type": [
            "string",
            "null"
          ],
          "description": "The expiration date."
        },
        "transferred": {
          "type": [
            "string",
            "null"
          ],
          "description": "The last transfer date."
        },
        "status": {
          "type": "array",
          "description": "EPP status values.",
          "items": {
            "type": "string",
            "description": "A status."
          }
        }
      }
    },
    "Change": {
      "title": "Change",
      "type": "object",
      "description": "A change a source records.",
      "required": [
        "kind",
        "date",
        "detail",
        "source"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "What changed.",
          "enum": [
            "renamed",
            "previous_legal_name",
            "acquisition_or_disposition",
            "change_in_control",
            "merger_review",
            "parent",
            "domain_registered",
            "domain_transferred"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "description": "When, as the source dates it; null when it gives no date."
        },
        "detail": {
          "type": "string",
          "description": "The change in words."
        },
        "source": {
          "type": "string",
          "description": "Where to read it."
        }
      }
    },
    "Subject": {
      "title": "NamedSubject",
      "type": "object",
      "description": "A subject the reading names (docs/IDS.md).",
      "required": [
        "id",
        "kind",
        "basis"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The Trooth id.",
          "pattern": "^trooth:[a-z_]+:.+$"
        },
        "kind": {
          "type": "string",
          "description": "What it names.",
          "enum": [
            "domain",
            "entity",
            "sec_filer",
            "lei",
            "jurisdiction",
            "state_registry",
            "sam_uei",
            "code_repository",
            "api",
            "mcp_server"
          ]
        },
        "basis": {
          "type": "string",
          "description": "Why the reading names it."
        }
      }
    },
    "Entity": {
      "title": "Entity",
      "type": "object",
      "description": "A legal entity, named by a Trooth id derived from its LEI or SEC CIK (docs/IDS.md).",
      "required": [
        "id",
        "name",
        "identifiers",
        "basis"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "trooth:entity:lei:<LEI> when the LEI binding is corroborated, otherwise trooth:entity:cik:<CIK>.",
          "pattern": "^trooth:entity:(lei:[A-Z0-9]{18}[0-9]{2}|cik:[0-9]{10})$"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "The legal name the registry holds."
        },
        "identifiers": {
          "type": "array",
          "description": "The corroborated identifiers (trooth:lei, trooth:cik).",
          "items": {
            "type": "string",
            "description": "A Trooth id."
          }
        },
        "basis": {
          "type": "string",
          "description": "Which bindings are corroborated."
        }
      }
    },
    "Certificates": {
      "title": "Certificates",
      "type": "object",
      "description": "Certificates for the exact domain name in Certificate Transparency logs.",
      "required": [
        "source",
        "unexpired",
        "issuers",
        "newest_issued",
        "soonest_expiry",
        "page_full"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "The CT monitor URL read."
        },
        "unexpired": {
          "type": "integer",
          "description": "How many unexpired certificates the monitor returned.",
          "minimum": 0
        },
        "issuers": {
          "type": "array",
          "description": "The issuing authorities, at most 10.",
          "items": {
            "type": "string",
            "description": "An issuer."
          }
        },
        "newest_issued": {
          "type": [
            "string",
            "null"
          ],
          "description": "The latest not-before time."
        },
        "soonest_expiry": {
          "type": [
            "string",
            "null"
          ],
          "description": "The earliest not-after time."
        },
        "page_full": {
          "type": "boolean",
          "description": "True when the monitor's first page was full, so there may be more."
        }
      }
    },
    "SecurityTxt": {
      "title": "SecurityTxt",
      "type": "object",
      "description": "A security.txt file (RFC 9116).",
      "required": [
        "url",
        "contacts",
        "expires",
        "expired",
        "policy",
        "canonical",
        "signed"
      ],
      "properties": {
        "url": {
          "type": "string",
          "description": "Where it was read."
        },
        "contacts": {
          "type": "array",
          "description": "Contact fields, at most 5.",
          "items": {
            "type": "string",
            "description": "A contact URI."
          }
        },
        "expires": {
          "type": [
            "string",
            "null"
          ],
          "description": "The Expires field."
        },
        "expired": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether Expires was in the past when read; null when it does not parse."
        },
        "policy": {
          "type": [
            "string",
            "null"
          ],
          "description": "The Policy field."
        },
        "canonical": {
          "type": "array",
          "description": "Canonical fields.",
          "items": {
            "type": "string",
            "description": "A URI."
          }
        },
        "signed": {
          "type": "boolean",
          "description": "Whether the file is OpenPGP clear-signed. The signature is not checked."
        }
      }
    },
    "Sanctions": {
      "title": "Sanctions",
      "type": "object",
      "description": "An exact-name check against a sanctions list.",
      "required": [
        "list",
        "source",
        "read_at",
        "names_checked",
        "matches"
      ],
      "properties": {
        "list": {
          "type": "string",
          "description": "The list and the part of it read."
        },
        "source": {
          "type": "string",
          "description": "The list URL."
        },
        "read_at": {
          "type": "string",
          "description": "When the list was read. An ISO 8601 date-time in UTC, as written by Trooth (for example 2026-10-06T20:00:44.820Z)."
        },
        "names_checked": {
          "type": "array",
          "description": "The legal names checked.",
          "items": {
            "type": "string",
            "description": "A name."
          }
        },
        "matches": {
          "type": "array",
          "description": "Entries with exactly one of those names (case, punctuation and suffix spellings folded). A name match is not an identification.",
          "items": {
            "$ref": "#/$defs/SanctionsEntry"
          }
        }
      }
    },
    "SanctionsEntry": {
      "title": "SanctionsEntry",
      "type": "object",
      "description": "A list entry.",
      "required": [
        "uid",
        "name",
        "programs"
      ],
      "properties": {
        "uid": {
          "type": "string",
          "description": "The entry number on the list."
        },
        "name": {
          "type": "string",
          "description": "The name as listed."
        },
        "programs": {
          "type": "string",
          "description": "The sanctions programs."
        }
      }
    },
    "Source": {
      "title": "Source",
      "type": "object",
      "description": "One response read.",
      "required": [
        "url",
        "status",
        "sha256",
        "bytes",
        "complete",
        "fetched_at"
      ],
      "properties": {
        "url": {
          "type": "string",
          "description": "The URL requested."
        },
        "status": {
          "type": "integer",
          "description": "The HTTP status."
        },
        "sha256": {
          "type": "string",
          "description": "SHA-256 of the bytes read, hex.",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "description": "How many bytes were read.",
          "minimum": 0
        },
        "complete": {
          "type": "boolean",
          "description": "False when only the start of the document was read (a filing's first 256 KB)."
        },
        "fetched_at": {
          "type": "string",
          "description": "When it was requested. An ISO 8601 date-time in UTC, as written by Trooth (for example 2026-10-06T20:00:44.820Z)."
        }
      }
    },
    "Signed": {
      "title": "Signed",
      "type": "object",
      "description": "The statement naming the reading, and its log receipt.",
      "required": [
        "record_sha256",
        "record_canonicalization",
        "statement",
        "statement_id",
        "log",
        "problem"
      ],
      "properties": {
        "record_sha256": {
          "type": "string",
          "description": "SHA-256, hex, of the RFC 8785 bytes of the reading without `signed` (finite numbers in ECMAScript shortest form).",
          "pattern": "^[0-9a-f]{64}$"
        },
        "record_canonicalization": {
          "type": "string",
          "description": "How those bytes were made.",
          "const": "RFC8785"
        },
        "statement": {
          "oneOf": [
            {
              "$ref": "witness-statement.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "The signed envelope; its payload is a public-record-statement.v1 document. Null when the reading could not be signed."
        },
        "statement_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "trooth:statement:<sha256 of the payload>."
        },
        "log": {
          "oneOf": [
            {
              "$ref": "log-receipt.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "The receipt of the statement as a public_record entry of the witness statement log, or null when it was not logged."
        },
        "problem": {
          "type": [
            "string",
            "null"
          ],
          "description": "What could not be done (not signed, or signed and not logged), or null."
        }
      }
    },
    "PublicFact": {
      "title": "PublicFact",
      "type": "object",
      "description": "One fact as its source published it, with the URL it was read from.",
      "required": [
        "key",
        "label",
        "value",
        "source"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "A stable key, source.field (for example sec.tickers, lei.jurisdiction, dns.mta_sts)."
        },
        "label": {
          "type": "string",
          "description": "The fact as words."
        },
        "value": {
          "description": "The value as published: text, a number, true or false, a list of text, or null when the source states nothing.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "source": {
          "type": "string",
          "description": "Where it was read: a URL, or dns:<name> <type> for a DNS record."
        }
      }
    },
    "BindingEvidence": {
      "title": "BindingEvidence",
      "type": "object",
      "description": "One piece of evidence for or against a binding.",
      "required": [
        "kind",
        "detail",
        "source"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "For: filing_namespace_names_domain, registry_lists_domain, through_corroborated_filer (these tie the identifier to the domain), site_names_registry_name (a claim by the site), registries_agree, edgar_names_lei. Against: registry_lists_other_domain, registries_disagree, edgar_names_other_lei."
        },
        "detail": {
          "type": "string",
          "description": "What was seen, as a sentence."
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where it was seen, or null when it follows from other evidence."
        }
      }
    },
    "EntityBinding": {
      "title": "EntityBinding",
      "type": "object",
      "description": "A link between the domain and a legal-entity identifier, with the evidence for and against it. Nothing is asserted beyond the evidence.",
      "required": [
        "identifier",
        "value",
        "id",
        "found_by",
        "status",
        "for",
        "against"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "description": "cik (SEC Central Index Key) or lei (Legal Entity Identifier).",
          "enum": [
            "cik",
            "lei"
          ]
        },
        "value": {
          "type": "string",
          "description": "The identifier: 10 digits for a CIK, 20 characters for an LEI."
        },
        "id": {
          "type": "string",
          "description": "The stable id: trooth:cik:<10 digits> or trooth:lei:<LEI> (docs/IDS.md).",
          "pattern": "^trooth:(cik:[0-9]{10}|lei:[A-Z0-9]{20})$"
        },
        "found_by": {
          "type": "string",
          "description": "How the identifier was found: asked (given by the requester), ticker, site_legal_name (the legal name the site states matched exactly one listed SEC filer), edgar_lei_field, registry_name_match (exact legal name and, when the SEC gives one, the jurisdiction).",
          "enum": [
            "asked",
            "ticker",
            "site_legal_name",
            "edgar_lei_field",
            "registry_name_match"
          ]
        },
        "status": {
          "type": "string",
          "description": "corroborated: authoritative evidence ties it to the domain (the company's own filing or the registry record names the domain). claimed_by_site: the site names this entity, and nothing authoritative ties it. registries_only: registries agree with each other, nothing ties the domain. uncorroborated: no evidence either way. contradicted: authoritative evidence points elsewhere. not_found: the registry holds no such identifier.",
          "enum": [
            "corroborated",
            "claimed_by_site",
            "registries_only",
            "uncorroborated",
            "contradicted",
            "not_found"
          ]
        },
        "for": {
          "type": "array",
          "description": "Evidence for the binding.",
          "items": {
            "$ref": "#/$defs/BindingEvidence"
          }
        },
        "against": {
          "type": "array",
          "description": "Evidence against it.",
          "items": {
            "$ref": "#/$defs/BindingEvidence"
          }
        }
      }
    },
    "Filing": {
      "title": "Filing",
      "type": "object",
      "description": "One SEC filing, as EDGAR lists it.",
      "required": [
        "form",
        "filed",
        "report_date",
        "items",
        "description",
        "url"
      ],
      "properties": {
        "form": {
          "type": "string",
          "description": "The form type (10-K, 10-Q, 8-K, DEF 14A, 20-F ...)."
        },
        "filed": {
          "type": "string",
          "description": "The filing date, YYYY-MM-DD."
        },
        "report_date": {
          "type": [
            "string",
            "null"
          ],
          "description": "The period or event date, when EDGAR gives one."
        },
        "items": {
          "type": "array",
          "description": "For an 8-K, the item numbers it reports (for example 1.05, 4.01).",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "EDGAR's description of the primary document."
        },
        "url": {
          "type": "string",
          "description": "The primary document on www.sec.gov."
        }
      }
    },
    "FinancialFact": {
      "title": "FinancialFact",
      "type": "object",
      "description": "A value the company filed in XBRL, as it filed it: the latest annual (10-K, full fiscal year) value of the concept.",
      "required": [
        "tag",
        "label",
        "value",
        "unit",
        "period_start",
        "period_end",
        "form",
        "filed",
        "accession",
        "source"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "description": "The XBRL concept, taxonomy:Name."
        },
        "label": {
          "type": "string",
          "description": "The concept as words."
        },
        "value": {
          "type": "number",
          "description": "The value as filed."
        },
        "unit": {
          "type": "string",
          "description": "The unit (USD)."
        },
        "period_start": {
          "type": [
            "string",
            "null"
          ],
          "description": "The period start for a flow such as revenue; null for a balance such as assets."
        },
        "period_end": {
          "type": "string",
          "description": "The period end."
        },
        "form": {
          "type": "string",
          "description": "The form the value was filed in."
        },
        "filed": {
          "type": "string",
          "description": "The filing date."
        },
        "accession": {
          "type": "string",
          "description": "The accession number of that filing."
        },
        "source": {
          "type": "string",
          "description": "The data.sec.gov URL the value was read from."
        }
      }
    },
    "SiteRead": {
      "title": "SiteRead",
      "type": "object",
      "description": "The legal names the company's pages state in copyright notices.",
      "required": [
        "legal_names",
        "read",
        "reason"
      ],
      "properties": {
        "legal_names": {
          "type": "array",
          "description": "Each legal name stated, with the page.",
          "items": {
            "$ref": "#/$defs/SiteName"
          }
        },
        "read": {
          "type": "boolean",
          "description": "Whether any page of the site could be read."
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why no name was found, or why the site was not read (for example its robots.txt opts out)."
        },
        "links": {
          "type": "array",
          "description": "Pages the home page links to on the company's own domain: investor relations, trust center, security, status, sustainability. Linked, not read. Added in trooth 0.11.0.",
          "items": {
            "$ref": "#/$defs/SiteLink"
          }
        }
      }
    },
    "SiteLink": {
      "title": "SiteLink",
      "type": "object",
      "description": "A page the home page links to.",
      "required": [
        "kind",
        "url"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "What the page is.",
          "enum": [
            "investor_relations",
            "trust_center",
            "security",
            "status",
            "sustainability"
          ]
        },
        "url": {
          "type": "string",
          "description": "The link, without query or fragment."
        }
      }
    },
    "SiteName": {
      "title": "SiteName",
      "type": "object",
      "description": "A legal name a page states.",
      "required": [
        "name",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The name as written."
        },
        "source": {
          "type": "string",
          "description": "The page."
        }
      }
    },
    "SecRecord": {
      "title": "SecRecord",
      "type": "object",
      "description": "The SEC filer's registration facts, filings and annual XBRL values.",
      "required": [
        "cik",
        "facts",
        "latest",
        "events",
        "events_cover_since",
        "cybersecurity_incidents",
        "auditor_changes",
        "non_reliance",
        "insider_forms_last_90_days",
        "financials"
      ],
      "properties": {
        "cik": {
          "type": "string",
          "description": "The Central Index Key, 10 digits.",
          "pattern": "^[0-9]{10}$"
        },
        "facts": {
          "type": "array",
          "description": "Registration facts on file with the SEC.",
          "items": {
            "$ref": "#/$defs/PublicFact"
          }
        },
        "latest": {
          "type": "object",
          "description": "The latest filing of each key form type, keyed by form.",
          "additionalProperties": {
            "$ref": "#/$defs/Filing"
          }
        },
        "events": {
          "type": "array",
          "description": "8-K filings of the last two years, newest first, at most 50.",
          "items": {
            "$ref": "#/$defs/Filing"
          }
        },
        "events_cover_since": {
          "type": [
            "string",
            "null"
          ],
          "description": "The earliest date the events cover."
        },
        "cybersecurity_incidents": {
          "type": "array",
          "description": "8-K filings reporting Item 1.05, a material cybersecurity incident.",
          "items": {
            "$ref": "#/$defs/Filing"
          }
        },
        "auditor_changes": {
          "type": "array",
          "description": "8-K filings reporting Item 4.01, a change of certifying accountant.",
          "items": {
            "$ref": "#/$defs/Filing"
          }
        },
        "non_reliance": {
          "type": "array",
          "description": "8-K filings reporting Item 4.02, non-reliance on financial statements issued before.",
          "items": {
            "$ref": "#/$defs/Filing"
          }
        },
        "insider_forms_last_90_days": {
          "type": "integer",
          "description": "Forms 3, 4 and 5 filed in the last 90 days.",
          "minimum": 0
        },
        "financials": {
          "type": "array",
          "description": "Annual values as filed.",
          "items": {
            "$ref": "#/$defs/FinancialFact"
          }
        }
      }
    },
    "LeiRecord": {
      "title": "LeiRecord",
      "type": "object",
      "description": "The Legal Entity Identifier record.",
      "required": [
        "lei",
        "facts",
        "direct_parent",
        "ultimate_parent"
      ],
      "properties": {
        "lei": {
          "type": "string",
          "description": "The LEI.",
          "pattern": "^[A-Z0-9]{20}$"
        },
        "facts": {
          "type": "array",
          "description": "The record's facts.",
          "items": {
            "$ref": "#/$defs/PublicFact"
          }
        },
        "direct_parent": {
          "oneOf": [
            {
              "$ref": "#/$defs/Parent"
            },
            {
              "type": "null"
            }
          ],
          "description": "The direct parent the record reports, or null."
        },
        "ultimate_parent": {
          "oneOf": [
            {
              "$ref": "#/$defs/Parent"
            },
            {
              "type": "null"
            }
          ],
          "description": "The ultimate parent the record reports, or null."
        }
      }
    },
    "Parent": {
      "title": "Parent",
      "type": "object",
      "description": "A parent entity.",
      "required": [
        "lei",
        "name"
      ],
      "properties": {
        "lei": {
          "type": "string",
          "description": "The parent's LEI."
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Its legal name."
        }
      }
    },
    "NotRead": {
      "title": "NotRead",
      "type": "object",
      "description": "A source not read.",
      "required": [
        "source",
        "reason"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "The source."
        },
        "reason": {
          "type": "string",
          "description": "Why."
        }
      }
    }
  }
}
