{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__exporter__.*",
        "hooks": [
          {
            "type": "command",
            "command": "npx trooth guard hook --policy .trooth/export-live.yaml --cache .trooth-cache",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
